---
import { formatDate } from '../utils/formatDate';
import { readingTime } from '../utils/readingTime';
import { excerpt } from '../utils/excerpt';
import { SHOW_READING_TIME, SHOW_EXCERPTS } from '../consts';

const { posts } = Astro.props;

function metaText(post) {
  const date = formatDate(post.data.date);
  return SHOW_READING_TIME ? `${date} · ${readingTime(post.body)}` : date;
}
---

<ul class:list={['post-list', { 'has-excerpts': SHOW_EXCERPTS }]}>
  {
    posts.map((post) => (
      <li>
        <span class="post-date">{metaText(post)}</span>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        {SHOW_EXCERPTS && (
          <p class="post-excerpt">{post.data.description ?? excerpt(post.body)}</p>
        )}
      </li>
    ))
  }
</ul>
