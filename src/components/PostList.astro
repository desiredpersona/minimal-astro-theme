---
import { formatDate } from '../utils/formatDate';

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <span class="post-date">{formatDate(post.data.date)}</span>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
      </li>
    ))
  }
</ul>
