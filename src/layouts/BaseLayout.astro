---
import '../styles/global.css';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  X_HANDLE,
  X_URL,
  SOCIAL_IMAGE,
} from '../consts';

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = SOCIAL_IMAGE,
  imageAlt = SITE_TITLE,
  type = 'website',
  publishedTime,
  modifiedTime,
  // Asks search engines not to list this page, while still following its
  // links. Pages marked this way are also left out of the sitemap.
  noindex = false,
} = Astro.props;

// Social networks need absolute URLs, so these are built from `site` in astro.config.mjs
const pageURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph: link previews on X, Facebook, LinkedIn, iMessage, Slack, etc. -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    <!-- X card -->
    <meta name="twitter:card" content="summary_large_image" />
    {X_HANDLE && <meta name="twitter:site" content={X_HANDLE} />}
    {X_HANDLE && <meta name="twitter:creator" content={X_HANDLE} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <main>
      <slot />
      <footer>
        {X_URL && <a href={X_URL}>{X_HANDLE}</a>}
      </footer>
    </main>
  </body>
</html>
